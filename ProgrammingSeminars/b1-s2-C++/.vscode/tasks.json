{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Debug Polynomial",
            "command": "/usr/bin/g++-15",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "main.cpp",
                "arithmetic_expressions_context.h",
                "binomial_priority_queue.h",
                "int_wrapper.cpp",
                "int_wrapper.h",
                "mergeable_priority_queue.h",
                "one_more_main.c",
                "polynomial.h",
                "priority_queue.h",
                "trie.h",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}